            "value": "Unknown"
          }
        }
      }
    },
    "앞줄 %lld/%lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Front row %1$lld/%2$lld"
          }
        }
      }
    },
    "앞줄을 뒤로 밀었어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Front row pushed back"
          }
        }
      }
    },
    "앞줄이 상자 %lld개로 꽉 찼어요. 쌓인 상자를 뒤로 밀고, 이 상자부터 새 줄에 쌓아요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The front row is full with %lld boxes. The stacks were pushed back, and a new row starts with this box."
          }
        }
      }
    },
    "어느 문의 열쇠인지는 아무도 몰라요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody knows which door it opens."
          }
        }
      }
    },
    "어둠 속에서 무언가 숨 쉬는 게 느껴져요. 오래 열어두면 빠져나갈지도 몰라요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can feel something breathing in the dark. Leave it open too long and it may slip out."
          }
        }
      }
    },
    "어디서 날아 들어왔을까요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where could it have blown in from?"
          }
        }
      }
    },
    "열어둔 사이 구석의 기척이 빠져나가고, 작은 발자국만 남았어요. 이 상자는 열린 채로 창고에 쌓여요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While it was open, whatever was in the corner slipped out, leaving only tiny pawprints. This box will be stacked open in the warehouse."
          }
        }
      }
    },
    "열어둔 지 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open for %@"
          }
        }
      }
    },
    "열어본 횟수": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Times opened"
          }
        }
      }
    },
