          "stringUnit": {
            "state": "translated",
            "value": "Putting the phone in the box"
          }
        }
      }
    },
    "흔들면 아주 작게 딸랑거려요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It gives a tiny jingle when shaken."
